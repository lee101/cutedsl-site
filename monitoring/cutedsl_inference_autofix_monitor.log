eleration and inference platform using custom Triton kernels and fused pipelines. Powered by $CUTEDSL on Solana.","url":"https://cutedsl.cc","codeRepository":"https://github.com/lee101/cutedsl","creator":{"@type":"Organization","name":"Applied Science Company","url":"https://app.nz"},"offers":{"@type":"Offer","priceCurrency":"USD","description":"Pay-per-use AI inference with $CUTEDSL tokens"},"sameAs":["https://github.com/lee101/cutedsl"]}</script><script src="/_next/static/chunks/polyfills-42372ed130431b0a.js" noModule=""></script></head><body class="font-nunito antialiased bg-pink-50 text-slate-800 selection:bg-pink-300 selection:text-pink-900"><div hidden=""><!--$--><!--/$--></div><div class="min-h-screen bg-gradient-to-b from-slate-50 to-white"><nav class="w-full p-6 flex justify-between items-center max-w-7xl mx-auto"><a class="flex items-center gap-2" href="/"><img alt="CuteDSL" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" class="rounded-lg" style="color:transparent" src="https://appstatic.app.nz/cutedsl/images/logo.webp"/><span class="font-fredoka text-3xl font-bold text-pink-600">CuteDSL</span></a><div class="flex gap-6 font-bold text-slate-700"><a class="hover:text-pink-500 transition-colors flex items-center gap-1" href="/"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg> Home</a><a class="hover:text-purple-500 transition-colors" href="/docs">Docs</a><a class="hover:text-cyan-500 transition-colors" href="/evals">Evals</a></div></nav><main class="max-w-5xl mx-auto px-6 pb-24"><div class="flex items-center gap-2 text-sm text-slate-400 mb-6"><a class="hover:text-pink-500 transition-colors" href="/docs">Docs</a><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"