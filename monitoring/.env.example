# Generated by ./monitoring/install_systemd.sh --provision-canary.
# Keep the real file mode 0600; monitoring/.env is gitignored.
CUTEDSL_MONITOR_API_KEY=cutedsl_replace_me

# Optional overrides
CUTEDSL_MONITOR_AGENT_MODEL=gpt-6.1-terra
CUTEDSL_MONITOR_AGENT_REASONING=high
CUTEDSL_SYNTHETIC_INTERVAL_SECONDS=21600
CUTEDSL_MONITOR_FAILURE_THRESHOLD=2
CUTEDSL_HEALTH_REQUEST_ATTEMPTS=3
CUTEDSL_HEALTH_RETRY_SECONDS=1
CUTEDSL_MONITOR_GLOBAL_COOLDOWN_SECONDS=3600
CUTEDSL_MONITOR_CATEGORY_COOLDOWN_SECONDS=10800
CUTEDSL_MONITOR_MAX_AGENT_RUNS_PER_DAY=4
