[Unit]
Description=CuteDSL production browser, backend, inference and auto-repair monitor
After=network-online.target cutedsl.service
Wants=network-online.target

[Service]
Type=oneshot
User=administrator
SupplementaryGroups=systemd-journal
WorkingDirectory=/nvme0n1-disk/code/cutedsl-site
EnvironmentFile=-/nvme0n1-disk/code/cutedsl-site/monitoring/.env
EnvironmentFile=-/etc/cutedsl-monitor.env
Environment=HOME=/home/administrator
Environment=PATH=/home/administrator/.bun/bin:/nvme0n1-disk/code/.venv/bin:/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
Environment=CUTEDSL_MONITOR_AGENT_MODEL=gpt-6.1-terra
Environment=CUTEDSL_MONITOR_AGENT_REASONING=high
Environment=CUTEDSL_MONITOR_FAILURE_THRESHOLD=2
Environment=CUTEDSL_MONITOR_GLOBAL_COOLDOWN_SECONDS=3600
Environment=CUTEDSL_MONITOR_CATEGORY_COOLDOWN_SECONDS=10800
Environment=CUTEDSL_MONITOR_MAX_AGENT_RUNS_PER_DAY=4
Environment=CUTEDSL_SYNTHETIC_INTERVAL_SECONDS=21600
ExecStart=/usr/bin/python3 /nvme0n1-disk/code/cutedsl-site/monitoring/cutedsl_monitor.py
TimeoutStartSec=4h
KillMode=control-group
UMask=0077
Nice=10
IOSchedulingClass=idle
SyslogIdentifier=cutedsl-monitor
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
