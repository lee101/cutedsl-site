[Unit]
Description=CuteDSL Site Server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cutedsl-site
ExecStart=/opt/cutedsl-site/server/cutedsl-server
Restart=always
RestartSec=5
EnvironmentFile=/opt/cutedsl-site/.env
# Default first-party model traffic to the shared native scheduler. A deployed
# CHRONOS_BACKEND_URL in .env can still override this during rollback.
Environment=OMNISERVE_NATIVE_URL=http://127.0.0.1:8791
Environment=ZIMAGE_BACKEND_URL=http://127.0.0.1:8791
Environment=ZIMAGE_BACKEND_STYLE=openai
Environment=PORT=8090
Environment=DEV=false
Environment=DIST_DIR=/opt/cutedsl-site/frontend/out
# ProtectSystem=strict leaves /tmp read-only; AV1 video optimization needs a
# writable scratch dir, so point Go's os.TempDir() at a ReadWritePath.
Environment=TMPDIR=/nvme0n1-disk/tmp
# Frontend error telemetry must be persisted by the service user. When the
# unit runs as the de-privileged svc-cutedsl account, /nvme0n1-disk/tmp itself
# is not writable, so the sink lives in a service-owned directory behind the
# stable /nvme0n1-disk/tmp/cutedsl-frontend-errors.jsonl symlink.
Environment=FRONTEND_ERROR_LOG_PATH=/nvme0n1-disk/tmp/cutedsl-logs/frontend-errors.jsonl

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cutedsl

# Security
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/cutedsl-site /nvme0n1-disk/tmp /sdb-disk/cutedsl-images

[Install]
WantedBy=multi-user.target
