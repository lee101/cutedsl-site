# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Stripe card checkout and auto top-up.
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are read by the Go backend.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_MONTHLY_PRICE_ID="price_1TZQWbQda7Fr1LvlkbnwaYpg"
STRIPE_ANNUAL_PRICE_ID="price_1TZQXvQda7Fr1Lvl2iOtzUx2"
STRIPE_CREDITS_PRODUCT_ID="prod_UYXp470kYWktY7"
# Optional: point backend Stripe API calls at a local mock during tests.
STRIPE_API_BASE_URL=""

# Default API metering prices in USD. The backend converts these into $CUTEDSL.
ZIMAGE_PRICE_USD="0.04"
ZIMAGE_20_40_STEPS_PRICE_USD="0.10"
ZIMAGE_DEFAULT_STEPS="8"
CHRONOS_PRICE_USD="0.02"
TTS_PRICE_USD_PER_100CHARS="0.005"
STT_PRICE_USD_PER_MINUTE="0.02"
GEMMA4_PRICE_USD="0.01"
CAPTION_PRICE_USD="0.01"
LORA_TRAINING_PRICE_USD="10"
LTX_VIDEO_PRICE_USD="0.30"
FLUX_IMAGE_PRICE_USD="0.04"
NSFW_DETECT_PRICE_USD="0.001"
